{
  "name": "wordcount",
  "version": "1",
  "source": {
    "type": "generator",
    "records": [
      { "key": "sentence", "value": "hello world" },
      { "key": "sentence", "value": "hello mailer" }
    ]
  },
  "pipeline": [
    { "type": "flatMap", "flatMap": { "ref": "splitWords" } },
    { "type": "keyBy", "keyBy": { "ref": "byWord", "partitions": 4 } },
    { "type": "reduce", "reduce": { "ref": "builtin:count" } }
  ],
  "sink": {
    "type": "stdout"
  }
}
