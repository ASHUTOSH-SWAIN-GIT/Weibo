{
  "name": "wordcount",
  "version": "1",
  "source": {
    "type": "generator",
    "records": [
      { "key": "sentence", "value": "hello world" },
      { "key": "sentence", "value": "hello weibo" }
    ]
  },
  "pipeline": [
    { "id": "by-word", "type": "keyBy", "keyBy": { "field": "word", "partitions": 4 } },
    { "id": "count", "type": "reduce", "reduce": { "function": "count" } }
  ],
  "sink": {
    "type": "stdout"
  }
}
