# Copy to .env (or export directly) before running the gate commands in
# plans/production-validation.md Phase 1. Matches the env contract pinned by
# .github/workflows/integration.yml job tiers-live-services, so
# `make test-integration-live` works unchanged against this stack.

KAFKA_BROKERS=localhost:39092
POSTGRES_DSN=postgres://weibo:weibo@localhost:54320/weibo?sslmode=disable
SAVEPOINT_S3_BUCKET=weibo-savepoints
SAVEPOINT_S3_ENDPOINT=http://localhost:9002
SAVEPOINT_S3_PATH_STYLE=true
AWS_ACCESS_KEY_ID=weibo
AWS_SECRET_ACCESS_KEY=weibominio
AWS_REGION=us-east-1

# Generate with: openssl rand -hex 32
WEIBO_AUTH_TOKEN=
